# Proveedor del modelo: anthropic (por defecto) u openai (cualquier API compatible con Chat Completions)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opcional: modelo. Por defecto claude-haiku-4-5 (anthropic) o gpt-4.1-mini (openai)
LLM_MODEL=

# Solo si LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Límites de costo y uso
MAX_ITERACIONES=25
MAX_TOKENS_SESION=150000
MAX_TOKENS_DIA=2000000
MAX_SOLICITUDES_POR_MINUTO=20
LLM_TIMEOUT_MS=60000

# Opcional: fija la fecha de ejecución (YYYY-MM-DD) para reproducir vigencias de soportes
FECHA_EJECUCION=
PORT=3000
